# VERITAS AI Environment Configuration
PROJECT_NAME="VERITAS AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for self-contained execution; PostgreSQL supported)
DATABASE_URL="sqlite:///./veritas_ai.db"

# Artifacts & Storage Paths
DATA_DIR="./ml/data"
ARTIFACTS_DIR="./ml/artifacts"
EXPERIMENTS_DIR="./ml/experiments"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Calibration & Inference Thresholds
ABSTENTION_THRESHOLD=0.60
DEFAULT_TEMPERATURE=1.0

# Worker & Background Tasks
MAX_CONCURRENT_TRAINING_JOBS=2
